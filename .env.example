# Postgres — lo usan la Secuencia STEM+ (/stem/misiones) y la Billetera Virtual.
# El Robot mensajero (/stem/robot) y Mundialito (/mundialito) NO lo necesitan.
# Aplicar los dos esquemas: npm run db:push
DATABASE_URL=postgres://usuario:clave@localhost:5432/crestech_didactico

# PIN compartido con el que los docentes entran al panel de la Billetera.
TEACHER_PIN=

# MongoDB — sólo lo usa el editor de bloques (/admin y /courses/*).
# Sin esto el catálogo público igual funciona; el panel avisa que no pudo leer.
MONGODB_URI=mongodb://localhost:27017/didakt

# Opcional: URL pública del sitio, para los metadatos.
NEXT_PUBLIC_SITE_URL=https://didactico.crestech.com.ar
