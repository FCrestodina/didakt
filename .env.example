# Postgres — única base del hub. La usan la Secuencia STEM+ (/stem/misiones),
# la Billetera Virtual y el editor de bloques (/admin).
# El catálogo público, el Robot mensajero (/stem/robot) y Mundialito
# (/mundialito) NO la necesitan: andan sin base.
# Aplicar los tres esquemas: npm run db:push
DATABASE_URL=postgres://usuario:clave@localhost:5432/crestech_didactico

# PIN compartido con el que los docentes entran al panel de la Billetera.
TEACHER_PIN=

# Opcional: URL pública del sitio, para los metadatos.
NEXT_PUBLIC_SITE_URL=https://didactico.crestech.com.ar
